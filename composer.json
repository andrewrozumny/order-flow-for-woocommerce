{
	"name": "andrewrozumny/order-flow-for-woocommerce",
	"description": "Custom WooCommerce order statuses with transitions, history, emails and PDF documents.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Andrew Rozumny",
			"homepage": "https://helpmybiz.org"
		}
	],
	"require": {
		"php": ">=8.1",
		"dompdf/dompdf": "^3.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"humanmade/psalm-plugin-wordpress": "^3.1",
		"php-stubs/woocommerce-stubs": "*",
		"php-stubs/wp-cli-stubs": "*",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha",
		"phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.1",
		"phpunit/phpunit": "^9.6",
		"smalot/pdfparser": "^2.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"vimeo/psalm": "^6.20",
		"wp-coding-standards/wpcs": "^3.0",
		"yoast/wp-test-utils": "^1.2"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "8.1.31"
		},
		"sort-packages": true,
		"optimize-autoloader": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G --no-progress",
		"taint": "psalm --taint-analysis --no-cache --threads=1 --no-progress",
		"test": "phpunit --testsuite unit",
		"test:integration": "bash bin/integration-test.sh",
		"i18n": "bash bin/i18n-check.sh",
		"plugin-check": "bash bin/plugin-check.sh",
		"matrix": "bash bin/matrix.sh",
		"gates": "bash bin/gates.sh"
	},
	"autoload-dev": {
		"psr-4": {
			"OrderFlowWC\\Tests\\": "tests/"
		}
	}
}
